{
    "name": "marco/booking-service",
    "description": "Search and book services near a location",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo_sqlite": "*"
    },
    "suggest": {
        "ext-intl": "Better accent folding in service search (a fallback map is used otherwise)"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "serve": ["Composer\\Config::disableProcessTimeout", "php -S localhost:8000 -t public"]
    }
}
